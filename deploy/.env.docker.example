# 本机 Docker 部署用的环境模板（docker compose 会读项目根目录的 .env）。
#
#   cp deploy/.env.docker.example .env
#   vi .env                     # 至少改 POSTGRES_PASSWORD
#   docker compose up -d
#
# 或者直接跑脚本，它会自动生成带随机密码的 .env：
#   ./scripts/docker-local.sh up

# ── PostgreSQL 容器 ───────────────────────────────────────────
POSTGRES_USER=artex
# 改成你自己的强密码；compose 里没填会直接报错，不会用默认弱口令起库。
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=artex

# ── 宿主机暴露范围 ────────────────────────────────────────────
# 默认只绑回环。要局域网访问改成 0.0.0.0，并自己在前面加反代/防火墙。
ARTEX_BIND_HOST=127.0.0.1
ARTEX_PORT=8787
ARTEX_PROXY_PORT=8788

# 镜像 tag（默认 latest；本地构建时可用 docker compose build 覆盖）
ARTEX_TAG=latest

# ── 模型（也可进界面后再配）───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
