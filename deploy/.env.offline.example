# 离线部署用的环境模板（内网/断网机器）。
#
# 用法：
#   cp deploy/.env.offline.example deploy/.env
#   vi deploy/.env           # 至少填 ARTEX_PG_DSN 和模型配置
#   ./artexctl start
#
# 注意：这个文件里的值会被 artexctl 逐行 export，不会被执行。
# 值里不要带行内注释，也不要有多余空格。

# ── 数据库（必填）──────────────────────────────────────────────
# 格式：postgres://用户:密码@主机:端口/库名?sslmode=disable
# 内网自建库通常不需要 TLS；跨网段请改 require。
ARTEX_PG_DSN=postgres://artex:CHANGE_ME@127.0.0.1:5432/artex?sslmode=disable

# ── 监听范围 ──────────────────────────────────────────────────
# 默认只监听回环：管理面里有凭据和全部战果，不该默认暴露。
# 需要同事访问时改成 0.0.0.0，并在前面放一层反代/防火墙做认证。
ARTEX_BIND_HOST=127.0.0.1
ARTEX_PORT=8787
ARTEX_PROXY_PORT=8788

# 显式允许非回环监听（只有 ARTEX_BIND_HOST=0.0.0.0 时才需要）
# ARTEX_ALLOW_REMOTE_ACCESS=1

# ── 模型接入（内网网关或本地推理）───────────────────────────────
# 全部走 OpenAI 兼容协议时填 /v1 结尾的 base url。
# ARTEX_LLM_BASE_URL=http://llm.internal:8000/v1
# ARTEX_LLM_PROXY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── 录制代理 ──────────────────────────────────────────────────
# 默认校验证书（推荐）。内网有自签证书时把公司 CA 装进系统信任库；
# 只在排障时临时放开校验：
# ARTEX_TRAFFIC_INSECURE_TLS=1

# ── Agent 子进程环境隔离 ──────────────────────────────────────
# 默认会把平台凭据（DSN / 模型密钥）从 Bash 子进程里摘掉。
# 需要连你自己工具链的 token 也一起清掉时打开严格模式：
# ARTEX_BASH_ENV_STRICT=1

# ── 其它 ──────────────────────────────────────────────────────
# 关掉空响应自动重试（默认开）：
# ARTEX_LLM_EMPTY_RETRY=0
# 关掉 5.5 代模型 thinking 归一化（默认开）：
# ARTEX_THINKING_NORMALIZE=0
