# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 端口与监听范围
# ARTEX_BIND_HOST 是宿主机绑定地址，默认 127.0.0.1（只有本机能访问）。
# 要让局域网访问改成 0.0.0.0，并务必在前面套反代 + 访问控制。
ARTEX_BIND_HOST=127.0.0.1
ARTEX_PORT=8787
ARTEX_PROXY_PORT=8788

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
